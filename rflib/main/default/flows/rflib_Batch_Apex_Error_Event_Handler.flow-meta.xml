<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Reports the Batch Apex Error Event as an RFLIB log event so that it flows through the regular log event pipeline.</description>
        <name>Report_Batch_Apex_Error_Event</name>
        <label>Report Batch Apex Error Event</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <actionName>rflib_BatchApexErrorEventAdapter</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>events</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputParameters>
        <nameSegment>rflib_BatchApexErrorEventAdapter</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Flow to execute when Salesforce publishes a Batch Apex Error Event, which happens when a batch class declaring Database.RaisesPlatformEvents fails with an unhandled exception. All RFLIB platform event subscriptions are Flow based, so this Flow is the subscriber that hands the event to the RFLIB adapter.</description>
    <environments>Default</environments>
    <interviewLabel>Batch Apex Error Event Handler {!$Flow.CurrentDateTime}: {!$Record.AsyncApexJobId} - {!$Record.Phase}</interviewLabel>
    <label>RFLIB Batch Apex Error Event Handler</label>
